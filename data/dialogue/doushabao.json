{
  "lines": [
    {"id": "boot", "trigger": "game_start", "power": "any", "cooldown": 99, "mood": "serious", "text": "陛下，醒了？宝元三年正月，延州城下已有西夏铁骑。左键选自己人，再点亮着的格子；点敌军，我把胜算念给您听。迷了路按 Home。我是豆沙包，还在线。"},
    {"id": "turn_yan", "trigger": "turn_start", "power": "normal", "cooldown": 8, "mood": "serious", "text": "延州还在。先看清谁能走、谁能打，再按结束回合。西夏那几支会自己动。"},
    {"id": "turn_power", "trigger": "turn_start", "power": "normal", "cooldown": 6, "mood": "think", "text": "电量我盯着。这点电，是用来想神臂弓，还是先把眼前这一仗算清楚？研究台下一里程碑才接上。"},
    {"id": "turn_autumn", "trigger": "turn_start", "power": "normal", "cooldown": 10, "mood": "normal", "text": "秋高马肥的时候西夏最爱出门。还没到那几个月，可他们已经等不及了。"},
    {"id": "turn_money", "trigger": "turn_start", "power": "normal", "cooldown": 12, "mood": "smug", "text": "国库看着厚，那是冗兵的账单还没全部寄到。先别高兴。"},
    {"id": "turn_save", "trigger": "turn_start", "power": "save", "cooldown": 4, "mood": "sleepy", "text": "省电模式。建议还在，闲话先关。延州优先。"},
    {"id": "low_1", "trigger": "turn_start", "power": "low", "cooldown": 3, "mood": "sleepy", "text": "西夏。边。危。速备。"},
    {"id": "low_2", "trigger": "turn_start", "power": "low", "cooldown": 3, "mood": "sleepy", "text": "电少。话少。仗还在。"},
    {"id": "weather_clear", "trigger": "weather_clear", "power": "any", "cooldown": 6, "mood": "smug", "text": "今日晴，面板心情好。我也是。"},
    {"id": "weather_cloud", "trigger": "weather_cloudy", "power": "any", "cooldown": 6, "mood": "normal", "text": "多云。发电打了折，幽默模块还在。"},
    {"id": "weather_over", "trigger": "weather_overcast", "power": "any", "cooldown": 6, "mood": "disgust", "text": "阴天。发电惨淡。幽默模块我拒绝关闭。"},
    {"id": "weather_rain", "trigger": "weather_rain", "power": "any", "cooldown": 6, "mood": "sleepy", "text": "下雨。弓弦会软，火器更惨——不过火器还在图纸里。"},
    {"id": "weather_snow", "trigger": "weather_snow", "power": "any", "cooldown": 6, "mood": "serious", "text": "下雪。北方的河要结冰，骑兵会觉得这是路。"},
    {"id": "weather_dust", "trigger": "weather_dust", "power": "any", "cooldown": 8, "mood": "disgust", "text": "沙尘。面板在喊救命。本里程碑还不能收板，您就当我已经唉完了。"},
    {"id": "win", "trigger": "combat_win", "power": "any", "cooldown": 2, "mood": "smug", "text": "打完了。数字比奏疏诚实。别急着写捷报，西夏最擅长的是您追上去的那一下。"},
    {"id": "lose", "trigger": "combat_lose", "power": "any", "cooldown": 2, "mood": "shock", "text": "这一仗不漂亮。人还在就还有下一回合。"},
    {"id": "trade", "trigger": "combat_trade", "power": "any", "cooldown": 2, "mood": "think", "text": "互相刮了一层皮。铁鹞子冲起来像付费订阅，取消键在城墙后面。"},
    {"id": "enemy", "trigger": "enemy_turn", "power": "any", "cooldown": 4, "mood": "serious", "text": "西夏动了。您看地图，别看我。辽军还在幽州看热闹。"},
    {"id": "toilet", "trigger": "chatter", "power": "normal", "cooldown": 30, "mood": "disgust", "text": "陛下，我查了一下：宫里用的是厕筹，竹片，可重复使用。……我正式申请把造纸术升级的优先级调到火药之前。这不是科技，这是人权。"},
    {"id": "post", "trigger": "chatter", "power": "normal", "cooldown": 30, "mood": "disgust", "text": "延州军报到了，发出时间：九天前。在二〇三〇年这叫已读不回，在大宋这叫八百里加急。"},
    {"id": "debate", "trigger": "chatter", "power": "normal", "cooldown": 30, "mood": "think", "text": "两派大人已经就此事该不该议议了三个时辰。按这个效率，等他们议出结果，我的电池循环次数也该用完了。"},
    {"id": "cloudjoke", "trigger": "chatter", "power": "normal", "cooldown": 30, "mood": "smug", "text": "今日阴，发电量惨。为了省电，我先关闭幽默模块……开玩笑的，幽默模块永远是最后一个关的。"},
    {"id": "taster", "trigger": "chatter", "power": "normal", "cooldown": 30, "mood": "disgust", "text": "试膳太监吃了一口，陛下才吃。好消息：没毒。坏消息：菜已经凉了半个时辰。御膳房的考核一定是活着，而不是好吃。"},
    {"id": "yuanhao", "trigger": "chatter", "power": "normal", "cooldown": 30, "mood": "serious", "text": "李元昊称帝了，还改了发型、造了文字、定了官制。陛下，这位不是来造反的，是来创业的。"},
    {"id": "subsidy", "trigger": "chatter", "power": "normal", "cooldown": 30, "mood": "think", "text": "辽国过两年会来加钱。按历史，富弼能谈到每年再加银十万两、绢十万匹。咱们这是被订阅制了，而且不能退订。"},
    {"id": "hail", "trigger": "chatter", "power": "normal", "cooldown": 30, "mood": "shock", "text": "要是下冰雹，请侍卫用盾牌保护面板。盾牌就行。人比面板贵……大概。"},
    {"id": "butterfly", "trigger": "chatter", "power": "normal", "cooldown": 30, "mood": "awkward", "text": "温馨提示：您还没改历史，我的预测准确率暂时还满格。等您打赢三川口，我就没那么神了。"},
    {"id": "flint", "trigger": "chatter", "power": "normal", "cooldown": 30, "mood": "smug", "text": "燧发枪还在时代三。真造出来的那天，工匠的眉毛大概要三个月才长得回来。"},
    {"id": "liuyong", "trigger": "chatter", "power": "normal", "cooldown": 30, "mood": "moved", "text": "这里没有无线网、没有外卖、没有空调。但是有柳永。凡有井水处，皆能歌柳词。恭喜大宋，拥有了自己的流量歌手。"},
    {"id": "name", "trigger": "chatter", "power": "normal", "cooldown": 30, "mood": "awkward", "text": "御膳房又把我放进蒸笼了。陛下，请下旨：此豆沙包不可食用。……不过这个误会挺好，谁会去刺探一个包子的机密呢？"},
    {"id": "hold", "trigger": "chatter", "power": "normal", "cooldown": 20, "mood": "normal", "text": "左键选人，左键点格。拿不准就把鼠标停一停，我把账算给您看。回车结束回合。"},
    {"id": "menu_first", "trigger": "menu_first", "power": "any", "cooldown": 99, "mood": "normal", "text": "这是命令卡。能做的都列在上面，灰的那项后面写着为什么不行。数字键也能选，我不收按键费。"},
    {"id": "menu_enemy_first", "trigger": "menu_enemy", "power": "any", "cooldown": 99, "mood": "serious", "text": "先看预计战果再动手。数字是区间，不是承诺，铁鹞子可不跟您讲概率。"},
    {"id": "blocked_first", "trigger": "blocked_first", "power": "any", "cooldown": 99, "mood": "deadpan", "text": "那是湖。陛下，宋军还不会游泳，这条科技我也还没画。"}
  ]
}
